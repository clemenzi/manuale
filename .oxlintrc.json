{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "categories": {},
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.2.5"
    },
    "tailwindcss": {
      "callees": ["clsx", "cva", "cn"]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    ".pnpm-store/",
    ".turbo/",
    ".wrangler/",
    ".astro/",
    "dist/",
    "apps/lab/src/routeTree.gen.ts"
  ]
}
