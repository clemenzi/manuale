{
  "name": "manuale",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "start": "pnpm run dev",
    "build": "turbo build",
    "preview": "pnpm preview",
    "pdf:generate": "pnpm --filter @manuale/pdf-generator generate",
    "types:check": "turbo types:check",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate-types": "turbo generate-types --filter=@manuale/www",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "turbo": "^2.6.1"
  },
  "overrides": {
    "vite": "7.3.2"
  },
  "packageManager": "pnpm@11.4.0"
}
